<Window x:Class="SMART_CLINIC_SOFTWAR_2026.View.Services.Cust_ServicesHestoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Services"
        xmlns:vm="clr-namespace:SMART_CLINIC_SOFTWAR_2026.ViewModel.Services"
        xmlns:customers="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Customers"
        xmlns:controls="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Resorsus.DataViews"
        mc:Ignorable="d"
        x:Name="ServicesHistoryWin"
        Title="سجل إجراءات المريض" 
        Height="620" 
        Width="950"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgMainBrush}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- 1. شريط البحث والتحكم العلوي -->
            <RowDefinition Height="Auto"/>
            <!-- 2. محتوى الجداول وبطاقة المريض -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. شريط البحث العادي العلوي المدمج -->
        <Border Grid.Row="0" 
                Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="8,6" 
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- زر المسح -->
                <Button Grid.Column="0" 
                        Command="{Binding ClearSearchCommand}"
                        Padding="10,5" 
                        Margin="0,0,8,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧹" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="مسح" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- حقل البحث مع مربع النص المائي -->
                <Grid Grid.Column="1">
                    <TextBox Text="{Binding SearchHistoryQuery, UpdateSourceTrigger=PropertyChanged}"
                             Padding="30,6,8,6" 
                             VerticalContentAlignment="Center" 
                             FontSize="13"
                             Background="{StaticResource SurfaceBrush}"
                             BorderBrush="{StaticResource BorderBrush}"/>

                    <TextBlock Text="🔍" 
                               HorizontalAlignment="Left" 
                               VerticalAlignment="Center" 
                               Margin="8,0,0,0" 
                               Foreground="Gray" 
                               IsHitTestVisible="False"/>

                    <TextBlock Text="البحث باسم الإجراء أو الكود أو النوع أو الملاحظات..." 
                               HorizontalAlignment="Left" 
                               VerticalAlignment="Center" 
                               Margin="32,0,0,0" 
                               Foreground="Gray" 
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchHistoryQuery}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SearchHistoryQuery}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. الجزء الرئيسي: الجدول الممتد مع بطاقة المريض المدمجة بالأسفل -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <!-- جدول البيانات يملأ المساحة الرئيسية للنافذة -->
                <RowDefinition Height="*"/>
                <!-- بطاقة المريض مثبتة بأسفل النافذة بشكل مباشر -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- جدول سوابق وإجراءات المريض -->
            <GroupBox Grid.Row="0" 
                      Header="سجل الإجراءات السابقة" 
                      FontWeight="Bold" 
                      Foreground="{StaticResource TextPrimaryBrush}" 
                      Background="{StaticResource SurfaceBrush}" 
                      BorderBrush="{StaticResource BorderBrush}" 
                      Margin="0,0,0,6" 
                      Padding="6">

                <controls:PaginatedGridControl 
                    ItemsSource="{Binding ServicesHistoryList}"
                    SelectedItem="{Binding SelectedHistoryService, Mode=TwoWay}"
                    CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
                    TotalRows="{Binding TotalRows, Mode=TwoWay}"
                    NumberOfRows="{Binding PageSize, Mode=TwoWay}"
                    PageChangedCommand="{Binding PageChangedCommand}"
                    RowDoubleClickCommand="{Binding SelectServiceCommand}"
                    RowDoubleClickCommandParameter="{Binding ElementName=ServicesHistoryWin}">

                    <DataGridTextColumn Header="كود الإجراء" Binding="{Binding SER_CODE}" Width="0.8*"/>
                    <DataGridTextColumn Header="اسم الإجراء" Binding="{Binding SER_NAME}" Width="2*"/>
                    <DataGridTextColumn Header="نوع الإجراء" Binding="{Binding SER_TYPE}" Width="1.2*"/>
                    <DataGridTextColumn Header="السعر" Binding="{Binding SER_PRICE}" Width="1*"/>
                    <DataGridTextColumn Header="الملاحظات" Binding="{Binding SER_NOTE}" Width="2.5*"/>

                </controls:PaginatedGridControl>
            </GroupBox>

            <!-- بطاقة المريض -->
            <customers:CustomerCard Grid.Row="1" 
                                   DataContext="{Binding CurrentCustomer}" 
                                   Margin="0"
                                   VerticalAlignment="Bottom"/>
        </Grid>
    </Grid>
</Window>
