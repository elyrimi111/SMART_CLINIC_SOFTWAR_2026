<Window x:Class="SMART_CLINIC_SOFTWAR_2026.View.Services.CustServeseFromViestWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Services"
        xmlns:customers="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Customers"
        xmlns:controls="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Resorsus.DataViews"
        xmlns:header="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Resorsus.Header"
        mc:Ignorable="d"
        Title="الإجراءات والخدمات في الزيارة" 
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft">

    <Grid Background="{StaticResource BgMainBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <header:MainHeader Grid.Row="0" Title="الإجراءات والخدمات من الكشف"/>

        <Border Grid.Row="1" 
                Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="10,6"
                Margin="8,8,8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnNewService" 
                            Command="{Binding NewServiceCommand}" 
                            Style="{StaticResource AccentButtonStyle}" 
                            Padding="14,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                            <TextBlock Text="إجراء جديد" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>


                    <Button x:Name="BtnPreviousService" 
                            Command="{Binding PreviousServiceCommand}" 
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="إجراء سابق" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnDelete" 
                            Command="{Binding DeleteCommand}" 
                            Style="{StaticResource DangerButtonStyle}" 
                            Margin="0,0,8,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✖" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                            <TextBlock Text="حذف" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnDeleteAll" 
                            Command="{Binding DeleteAllCommand}" 
                            Style="{StaticResource DangerButtonStyle}" 
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑️" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                            <TextBlock Text="حذف الكل" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="8,4,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" 
                      Header="قائمة الإجراءات العامة" 
                      FontWeight="Bold" 
                      Foreground="{StaticResource TextPrimaryBrush}" 
                      Background="{StaticResource SurfaceBrush}" 
                      BorderBrush="{StaticResource BorderBrush}" 
                      Margin="0,0,4,0" 
                      Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" 
                                 Text="{Binding SearchServiceQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" 
                                 VerticalContentAlignment="Center" 
                                 FontSize="13"
                                 Background="{StaticResource SurfaceBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"/>

                        <Button Grid.Column="1" 
                                Command="{Binding ClearSearchCommand}"
                                Padding="10,5" 
                                Margin="6,0,0,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧹" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="مسح" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- جدول الإجراءات العامة -->
                    <controls:PaginatedGridControl 
                             Grid.Row="1"
                             ItemsSource="{Binding AllServicesList}"
                             SelectedItem="{Binding SelectedAllService, Mode=TwoWay}"
                             CurrentPage="{Binding AllServicesCurrentPage, Mode=TwoWay}"
                             TotalRows="{Binding AllServicesTotalRows, Mode=TwoWay}"
                             NumberOfRows="{Binding AllServicesPageSize, Mode=TwoWay}"
                             PageChangedCommand="{Binding AllServicesPageChangedCommand}">

                        <DataGridTextColumn Header="الرقم" Binding="{Binding SER_CODE}" Width="0.7*"/>
                        <DataGridTextColumn Header="اسم الإجراء" Binding="{Binding SER_NAME}" Width="2*"/>
                        <DataGridTextColumn Header="نوع الإجراء" Binding="{Binding SER_TYPE}" Width="1.2*"/>
                        <DataGridTextColumn Header="سعر الإجراء" Binding="{Binding SER_PRICE, StringFormat='{}{0:N0}'}" Width="1*"/>

                    </controls:PaginatedGridControl>
                </Grid>
            </GroupBox>

            <!-- العمود الثاني: الإجراءات في الزيارة الحالية وبطاقة المريض -->
            <Grid Grid.Column="1" Margin="4,0,0,0">
                <Grid.RowDefinitions>
                    <!-- جدول إجراءات الزيارة الحالية -->
                    <RowDefinition Height="*"/>
                    <!-- بطاقة المريض مثبتة في الأسفل -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. جدول إجراءات الزيارة الحالية -->
                <GroupBox Grid.Row="0" 
                          Header="الإجراء في الزيارة" 
                          FontWeight="Bold" 
                          Foreground="{StaticResource TextPrimaryBrush}" 
                          Background="{StaticResource SurfaceBrush}" 
                          BorderBrush="{StaticResource BorderBrush}" 
                          Margin="0,0,0,6" 
                          Padding="6">

                    <controls:PaginatedGridControl 
                                 ItemsSource="{Binding VisitServicesList}"
                                 SelectedItem="{Binding SelectedVisitService, Mode=TwoWay}"
                                 CurrentPage="{Binding VisitPage, Mode=TwoWay}"
                                 TotalRows="{Binding VisitTotalRows, Mode=TwoWay}"
                                 NumberOfRows="{Binding VisitPageSize, Mode=TwoWay}"
                                 PageChangedCommand="{Binding VisitPageChangedCommand}">

                        <DataGridTextColumn Header="الرقم" Binding="{Binding SER_CODE}" Width="0.7*"/>
                        <DataGridTextColumn Header="اسم الإجراء" Binding="{Binding SER_NAME}" Width="2*"/>
                        <DataGridTextColumn Header="سعر الإجراء" Binding="{Binding SER_PRICE, StringFormat='{}{0:N0}'}" Width="1*"/>
                        <DataGridTextColumn Header="نوع الإجراء" Binding="{Binding SER_TYPE}" Width="1.2*"/>

                    </controls:PaginatedGridControl>
                </GroupBox>

                <!-- 2. بطاقة المريض بالأسفل تحت جدول إجراءات الزيارة -->
                <customers:CustomerCard Grid.Row="1" 
                                       DataContext="{Binding Customer}" 
                                       Margin="0"
                                       VerticalAlignment="Bottom"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
