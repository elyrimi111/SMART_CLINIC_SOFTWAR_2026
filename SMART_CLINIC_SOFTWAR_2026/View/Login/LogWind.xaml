<Window x:Class="SMART_CLINIC_SOFTWAR_2026.View.LoginView.LogWind"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.LoginView"
        xmlns:header="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Resorsus.Header"
        xmlns:converter="clr-namespace:SMART_CLINIC_SOFTWAR_2026.ViewModel.Helpers.Converter"
        mc:Ignorable="d"
        Title="تسجيل الدخول" 
        Height="540" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        FlowDirection="RightToLeft"
        Background="Transparent"
        AllowsTransparency="True">

    <Window.Resources>
        <converter:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <!-- كروت زجاجية متناسقة مع ثيم مدار الطبي -->
        <SolidColorBrush x:Key="GlassCardBg" Color="#E6FFFFFF"/>
        <SolidColorBrush x:Key="GlassBorderBrush" Color="#B8D5D8"/>
        <SolidColorBrush x:Key="UserTypeBgBrush" Color="#EFF5F5"/>
        <SolidColorBrush x:Key="InfoBoxBgBrush" Color="#F4F8F8"/>

        <!-- أيقونات Vector مميزة للوصف الطبي -->
        <StreamGeometry x:Key="IconClinic">M19,3H5C3.9,3 3,3.9 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.9 20.1,3 19,3M18,14H14V18H10V14H6V10H10V6H14V10H18V14Z</StreamGeometry>
        <StreamGeometry x:Key="IconPatient">M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z</StreamGeometry>
        <StreamGeometry x:Key="IconReport">M19,3H5C3.9,3 3,3.9 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V5M19,19H5V5H19V19M7,10H17V12H7V10M7,7H17V9H7V7M7,13H14V15H7V13Z</StreamGeometry>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- الشريط العلوي (الهيدر) -->
            <header:MainHeader Grid.Row="0" Title="تسجيل الدخول"/>

            <!-- خلفية النافذة الأساسية -->
            <Grid Grid.Row="1">

                <!-- عنصر الصورة الخلفية المتجاوب بدون تشويه -->
                <Image Source="/View/Resorsus/Assets/Images/Login_Background_Img.png"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <Image.RenderTransform>
                        <ScaleTransform ScaleX="-1" CenterX="0.5"/>
                    </Image.RenderTransform>
                    <Image.RenderTransformOrigin>
                        <Point X="0.5" Y="0.5"/>
                    </Image.RenderTransformOrigin>
                </Image>

                <!-- كارت تسجيل الدخول الزجاجي -->
                <Border Background="{StaticResource GlassCardBg}" 
                        BorderBrush="{StaticResource GlassBorderBrush}" 
                        BorderThickness="1.5" 
                        CornerRadius="14"
                        Width="410" 
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="369,99,0,0"
                        Padding="20,18">
                    <Border.Effect>
                        <DropShadowEffect Color="{StaticResource ColorPrimaryDark}" Direction="270" ShadowDepth="4" BlurRadius="18" Opacity="0.18"/>
                    </Border.Effect>

                    <StackPanel>

                        <!-- اسم المستخدم -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="اسم المستخدم" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <ComboBox x:Name="CmbUsername" 
                                      Grid.Column="1" 
                                      Height="30" 
                                      IsEditable="True"
                                      ItemsSource="{Binding UsersList}" 
                                      DisplayMemberPath="USER_NAME" 
                                      TextSearch.TextPath="USER_NAME"
                                      SelectedValuePath="USER_NAME"
                                      SelectedValue="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!-- كلمة المرور -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="كلمة المرور" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <PasswordBox x:Name="TxtPassword" 
                                         Grid.Column="1" 
                                         Height="30"/>
                        </Grid>

                        <!-- نوع المستخدم -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="نوع المستخدم" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Border Grid.Column="1" Background="{StaticResource UserTypeBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Height="30">
                                <TextBlock x:Name="TxtUserType" 
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Text="{Binding SelectedUserType, Mode=OneWay}"/>
                            </Border>
                        </Grid>

                        <!-- زر تسجيل الدخول -->
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnLogin" 
                                    Grid.Column="1" 
                                    Content="تسجيل الدخول" 
                                    Height="32" 
                                    IsDefault="True" 
                                    Cursor="Hand"
                                    Style="{StaticResource AccentButtonStyle}" 
                                    Command="{Binding LoginCommand}"
                                    CommandParameter="{Binding ElementName=TxtPassword}"/>
                        </Grid>

                        <!-- رسالة الخطأ (مساحة كافية تتسع للسطور دون قطع) -->
                        <Grid MinHeight="22" Margin="0,4,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ErrorMessage}" 
                                       Foreground="{StaticResource DangerBrush}" 
                                       FontSize="11" 
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}"/>
                        </Grid>

                        <!-- قسم الشرح المبسط للنظام -->
                        <Border Background="{StaticResource InfoBoxBgBrush}" 
                                BorderBrush="{StaticResource BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Margin="0,4,0,0" 
                                Padding="8,8">
                            <StackPanel>
                                <TextBlock Text="عن النظام" 
                                           FontSize="11" 
                                           FontWeight="Bold" 
                                           Foreground="{StaticResource PrimaryDarkBrush}" 
                                           Margin="0,0,0,6"
                                           HorizontalAlignment="Center"/>

                                <UniformGrid Columns="3">
                                    <!-- ميزة 1: إدارة المراكز -->
                                    <StackPanel HorizontalAlignment="Center" Margin="2">
                                        <Path Data="{StaticResource IconClinic}" Fill="{StaticResource PrimaryBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"/>
                                        <TextBlock Text="إدارة العيادات والمراكز" FontSize="9.5" TextAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- ميزة 2: المراجعين والزيارات -->
                                    <StackPanel HorizontalAlignment="Center" Margin="2">
                                        <Path Data="{StaticResource IconPatient}" Fill="{StaticResource PrimaryBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"/>
                                        <TextBlock Text="متابعة المرضى والزيارات" FontSize="9.5" TextAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- ميزة 3: التقارير والحسابات -->
                                    <StackPanel HorizontalAlignment="Center" Margin="2">
                                        <Path Data="{StaticResource IconReport}" Fill="{StaticResource PrimaryBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"/>
                                        <TextBlock Text="الحسابات والتقارير" FontSize="9.5" TextAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- حقوق الملكية -->
                        <Border Margin="0,8,0,0" 
                                Padding="0,6,0,0" 
                                BorderBrush="{StaticResource BorderBrush}" 
                                BorderThickness="0,1,0,0">
                            <TextBlock Text="جميع الحقوق محفوظة للمهندس محمد فؤاد اليريمي © 2026" 
                                       FontSize="10" 
                                       Foreground="{StaticResource TextMutedBrush}" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>

                    </StackPanel>
                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>
