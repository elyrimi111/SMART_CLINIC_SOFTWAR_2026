<UserControl x:Class="SMART_CLINIC_SOFTWAR_2026.View.Apointments.ApointmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Apointments"
             xmlns:vm="clr-namespace:SMART_CLINIC_SOFTWAR_2026.ViewModel.Apointments"
             xmlns:controls="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Resorsus.DataViews"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             FlowDirection="RightToLeft">

    <!-- ربط DataContext مع ViewModel -->
    <UserControl.DataContext>
        <vm:AppointmentsViewModel/>
    </UserControl.DataContext>

    <Grid Background="{StaticResource BgMainBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- الهيدر الرئيسي -->
        <Border Grid.Row="0" 
                Background="{StaticResource HeaderBgBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="10,8">
            <TextBlock Text="إضافة - تعديل المواعيد" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>

        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- القسم الأيمن: نموذج إدخال البيانات والأزرار -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" 
                          Header="بيانات الموعد" 
                          FontWeight="Bold" 
                          Foreground="{StaticResource TextPrimaryBrush}" 
                          Background="{StaticResource SurfaceBrush}" 
                          BorderBrush="{StaticResource BorderBrush}" 
                          Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,4">

                            <!-- اسم/رقم المريض -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="اسم المريض" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>
                                <TextBox Grid.Column="1" Text="{Binding CUST_ID, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Background="#F5F5F5" HorizontalContentAlignment="Center"/>
                                <TextBox Grid.Column="2" Text="{Binding CUST_NAME, Mode=OneWay, FallbackValue='اختر مريض...'}" IsReadOnly="True" Background="#F5F5F5" Margin="4,0,10,0" Padding="4,0" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="3" Command="{Binding OpenCustomersListCommand}" Content="🔍" ToolTip="اختيار مريض"/>
                            </Grid>

                            <!-- كود الموعد -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="كود الموعد" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>
                                <TextBox Grid.Column="1" Text="{Binding APO_CODE, UpdateSourceTrigger=PropertyChanged}" IsEnabled="False"/>
                            </Grid>

                            <!-- تاريخ الموعد -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="تاريخ الموعد" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>
                                <DatePicker Grid.Column="1" SelectedDate="{Binding APO_DATE, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center"/>
                            </Grid>

                            <!-- وقت الموعد -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="وقت الموعد" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>

                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- قائمة الساعات -->
                                    <ComboBox Grid.Column="0" 
                                              SelectedItem="{Binding SelectedHour, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">01</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">02</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">03</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">04</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">05</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">06</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">07</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">08</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">09</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">10</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">11</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">12</System:String>
                                    </ComboBox>

                                    <TextBlock Grid.Column="1" Text=":" VerticalAlignment="Center" Margin="4,0" FontWeight="Bold"/>

                                    <!-- قائمة الدقائق -->
                                    <ComboBox Grid.Column="2" 
                                              SelectedItem="{Binding SelectedMinute, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">00</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">05</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">10</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">15</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">20</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">25</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">30</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">35</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">40</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">45</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">50</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">55</System:String>
                                    </ComboBox>

                                    <!-- الفترة (AM/PM) -->
                                    <ComboBox Grid.Column="4" 
                                              SelectedItem="{Binding SelectedPeriod, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="4,0,0,0" Width="55"
                                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">AM</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">PM</System:String>
                                    </ComboBox>
                                </Grid>
                            </Grid>

                            <!-- ملاحظات -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ملاحظات" VerticalAlignment="Top" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,5,5,0"/>
                                <TextBox Grid.Column="1" Text="{Binding APO_NOTE, UpdateSourceTrigger=PropertyChanged}" Height="55" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                            </Grid>

                            <!-- اسم/رقم الطبيب -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="اسم الطبيب" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>
                                <TextBox Grid.Column="1" Text="{Binding DOC_ID, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Background="#F5F5F5" HorizontalContentAlignment="Center"/>
                                <TextBox Grid.Column="2" Text="{Binding DOC_NAME, Mode=OneWay, FallbackValue='اختر طبيب...'}" IsReadOnly="True" Background="#F5F5F5" Margin="4,0,10,0" Padding="4,0" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="3" Command="{Binding OpenDoctorsListCommand}" Content="🔍" ToolTip="اختيار طبيب"/>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>

                <!-- أزرار العمليات -->
                <Border Grid.Row="1" 
                        Background="{StaticResource HeaderBgBrush}" 
                        BorderBrush="{StaticResource BorderBrush}" 
                        BorderThickness="1" 
                        Margin="0,8,0,0" 
                        Padding="4">
                    <UniformGrid Columns="4" Rows="1">
                        <Button x:Name="BtnSave" 
                                Command="{Binding SaveAppointmentCommand}" 
                                Style="{StaticResource AccentButtonStyle}" 
                                Margin="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="💾" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                                <TextBlock Text="حفظ" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnEdit" 
                                Command="{Binding UpdateAppointmentCommand}" 
                                Margin="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✏️" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="تعديل" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnDelete" 
                                Command="{Binding DeleteAppointmentCommand}" 
                                Style="{StaticResource DangerButtonStyle}" 
                                Margin="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✖" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                                <TextBlock Text="حذف" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnClear" 
                                Command="{Binding ClearFieldsCommand}" 
                                Margin="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🧹" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="مسح" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Border>
            </Grid>

            <!-- القسم الأيسر: جدول المواعيد -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" 
                            Command="{Binding ClearSearchCommand}"
                            Padding="10,4" 
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧹" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="مسح" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <TextBox Grid.Column="1" 
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" 
                             VerticalContentAlignment="Center" 
                             FontSize="13"
                             Background="{StaticResource SurfaceBrush}"
                             BorderBrush="{StaticResource BorderBrush}"/>
                </Grid>

                <controls:PaginatedGridControl 
                             Grid.Row="1"
                             ItemsSource="{Binding AppointmentsList}"
                             SelectedItem="{Binding SelectedAppointment, Mode=TwoWay}"
                             CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
                             TotalRows="{Binding TotalRows, Mode=TwoWay}"
                             NumberOfRows="{Binding PageSize, Mode=TwoWay}"
                             PageChangedCommand="{Binding PageChangedCommand}">

                    <DataGridTextColumn Header="الرقم" Binding="{Binding APO_ID}" Width="0.6*"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding APO_DATE, StringFormat=\{0:dd/MM/yyyy\}}" Width="1.1*"/>
                    <DataGridTextColumn Header="الوقت" Binding="{Binding APO_TIME, StringFormat=\{0:hh\\:mm\}}" Width="0.9*"/>
                    <DataGridTextColumn Header="اسم المريض" Binding="{Binding CUST_NAME}" Width="1.8*"/>
                    <DataGridTextColumn Header="اسم الطبيب" Binding="{Binding DOC_NAME}" Width="1.5*"/>

                </controls:PaginatedGridControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
