<Window x:Class="SMART_CLINIC_SOFTWAR_2026.View.Apointments.AppointmentsListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Apointments"
        xmlns:vm="clr-namespace:SMART_CLINIC_SOFTWAR_2026.ViewModel.Apointments"
        xmlns:controls="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Resorsus.DataViews"
        mc:Ignorable="d"
        x:Name="AppointmentsWin"
        Title="قائمة المواعيد" 
        Height="600" 
        Width="950"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgMainBrush}">


    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- عنوان الشاشة -->
        <TextBlock Grid.Row="0" 
                   Text="قائمة المواعيد" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Foreground="{StaticResource TextPrimaryBrush}" 
                   Margin="0,-6,0,152"/>

        <!-- كادر البحث والفلترة -->
        <GroupBox Header="بحث وتصفية" Margin="10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- 0: اسم المريض / الطبيب -->
                    <ColumnDefinition Width="*"/>
                    <!-- 1: حقل النص لاسم المريض / الطبيب -->
                    <ColumnDefinition Width="20"/>
                    <!-- 2: مسافة فاصلة -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 3: من تاريخ / إلى تاريخ -->
                    <ColumnDefinition Width="*"/>
                    <!-- 4: DatePicker -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 5: أزرار البحث والمسح -->
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- السطر الأول: اختيار المريض ومن تاريخ -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="اسم المريض:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Grid Grid.Row="0" Grid.Column="1" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" 
                     Text="{Binding CUST_NAME, UpdateSourceTrigger=PropertyChanged}" 
                     IsReadOnly="True" 
                     Cursor="Hand"
                     VerticalContentAlignment="Center" 
                     Padding="5,0">
                        <TextBox.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCustomersListCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Grid.Column="1" Content="🔍" Command="{Binding OpenCustomersListCommand}" Width="30" Margin="4,0,0,0"/>
                </Grid>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="من تاريخ:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker Grid.Row="0" Grid.Column="4" SelectedDate="{Binding FromDate, Mode=TwoWay}" Margin="0,4"/>

                <!-- السطر الثاني: اختيار الطبيب وإلى تاريخ -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="اسم الطبيب:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" 
                     Text="{Binding DOC_NAME, UpdateSourceTrigger=PropertyChanged}" 
                     IsReadOnly="True" 
                     Cursor="Hand"
                     VerticalContentAlignment="Center" 
                     Padding="5,0">
                        <TextBox.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenDoctorsListCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Grid.Column="1" Content="🔍" Command="{Binding OpenDoctorsListCommand}" Width="30" Margin="4,0,0,0"/>
                </Grid>

                <TextBlock Grid.Row="1" Grid.Column="3" Text="إلى تاريخ:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker Grid.Row="1" Grid.Column="4" SelectedDate="{Binding ToDate, Mode=TwoWay}" Margin="0,4"/>

                <!-- أزرار العمليات: البحث والمسح مدمجة في العامود الخامس -->
                <StackPanel Grid.Row="0" Grid.Column="5" Grid.RowSpan="2" 
                    Orientation="Horizontal" Margin="15,4,0,4" VerticalAlignment="Stretch">

                    <!-- زر البحث (يتفعل فقط عند تحقق شرط CanExecute) -->
                    <Button Command="{Binding SearchCommand}"
                    Margin="0,0,6,0" Padding="14,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="بحث" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- زر المسح -->
                    <Button Command="{Binding ClearSearchCommand}"
                    Padding="14,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧹" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="مسح" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </GroupBox>


        <controls:PaginatedGridControl 
            Grid.Row="2"
            ItemsSource="{Binding AppointmentsList}"
            SelectedItem="{Binding SelectedAppointment, Mode=TwoWay}"
            CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
            TotalRows="{Binding TotalRows, Mode=TwoWay}"
            NumberOfRows="{Binding PageSize, Mode=TwoWay}"
            PageChangedCommand="{Binding PageChangedCommand}"
            RowDoubleClickCommand="{Binding SelectAppointmentCommand}"
            RowDoubleClickCommandParameter="{Binding ElementName=AppointmentsWin}">

            <DataGridTextColumn Header="الرقم" Binding="{Binding APO_ID}" Width="0.6*"/>
            <DataGridTextColumn Header="الكود" Binding="{Binding APO_CODE}" Width="0.8*"/>
            <DataGridTextColumn Header="التاريخ" Binding="{Binding APO_DATE, StringFormat={}{0:yyyy/MM/dd}}" Width="1.2*"/>
            <DataGridTextColumn Header="الوقت" Binding="{Binding APO_TIME}" Width="1*"/>
            <DataGridTextColumn Header="اسم المريض" Binding="{Binding CUST_NAME}" Width="1.8*"/>
            <DataGridTextColumn Header="اسم الطبيب" Binding="{Binding DOC_NAME}" Width="1.8*"/>
            <DataGridTextColumn Header="الملاحظات" Binding="{Binding APO_NOTE}" Width="2*"/>

        </controls:PaginatedGridControl>
    </Grid>
</Window>
