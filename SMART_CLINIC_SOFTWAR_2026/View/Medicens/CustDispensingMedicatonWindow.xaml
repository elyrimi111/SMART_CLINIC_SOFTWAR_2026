<Window x:Class="SMART_CLINIC_SOFTWAR_2026.View.Medicens.CustDispensingMedicatonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Medicens"
        xmlns:vm="clr-namespace:SMART_CLINIC_SOFTWAR_2026.ViewModel.Medicens"
        xmlns:customers="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Customers"
        xmlns:controls="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Resorsus.DataViews"
        mc:Ignorable="d"
        x:Name="CustDispensingMedWin"
        Title="صرف الأدوية للمريض" 
        Height="720" 
        Width="1100"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgMainBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- 1. شريط الأزرار والتحكم العلوي -->
            <RowDefinition Height="Auto"/>
            <!-- 2. الجزء الرئيسي: محتوى النافذة المقسم لجانبين -->
            <RowDefinition Height="*"/>
            <!-- 3. بطاقة بيانات المريض في الأسفل -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. شريط الأزرار العلوي -->
        <Border Grid.Row="0" 
                Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="8" 
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- أزرار التحكم والخيارات العامة -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding NewMedicationCommand}" 
                            Padding="12,6" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="دواء جديد" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding PrintCommand}" 
                            Padding="12,6" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="طباعة" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding PreviousMedicationCommand}" 
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📜" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="أدوية سابقة" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- أزرار الحذف -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding DeleteCommand}" 
                            Padding="12,6" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="❌" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="حذف" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DeleteAllCommand}" 
                            Padding="12,6" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑️" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="حذف الكل" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. محتوى النافذة الرئيسي -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= الجانب الأيمن: دليل الأدوية ================= -->
            <GroupBox Grid.Column="0" 
                      Header="دليل الأدوية" 
                      FontWeight="Bold" 
                      Foreground="{StaticResource TextPrimaryBrush}" 
                      Background="{StaticResource SurfaceBrush}" 
                      BorderBrush="{StaticResource BorderBrush}" 
                      Margin="0,0,6,0" 
                      Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- شريط البحث -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                Command="{Binding ClearSearchCommand}"
                                Padding="10,5" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧹" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="مسح" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Grid Grid.Column="1">
                            <TextBox Text="{Binding SearchMedicationQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="30,6,8,6" 
                                     VerticalContentAlignment="Center" 
                                     FontSize="13"
                                     Background="{StaticResource SurfaceBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"/>

                            <TextBlock Text="🔍" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray" IsHitTestVisible="False"/>
                            <TextBlock Text="البحث باسم الدواء أو الكود..." HorizontalAlignment="Left" VerticalAlignment="Center" Margin="32,0,0,0" Foreground="Gray" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchMedicationQuery}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SearchMedicationQuery}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <!-- جدول دليل الأدوية -->
                    <controls:PaginatedGridControl 
                        Grid.Row="1"
                        ItemsSource="{Binding AllMedicationsList}"
                        SelectedItem="{Binding SelectedAllMedication, Mode=TwoWay}"
                        CurrentPage="{Binding AllMedicationsCurrentPage, Mode=TwoWay}"
                        TotalRows="{Binding AllMedicationsTotalRows, Mode=TwoWay}"
                        NumberOfRows="{Binding AllMedicationsPageSize, Mode=TwoWay}"
                        PageChangedCommand="{Binding AllMedicationsPageChangedCommand}">

                        <controls:PaginatedGridControl.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" 
                                          Command="{Binding SelectMedicationOnDoubleClickCommand}" 
                                          CommandParameter="{Binding SelectedAllMedication}"/>
                        </controls:PaginatedGridControl.InputBindings>

                        <DataGridTextColumn Header="الرقم" Binding="{Binding MED_ID}" Width="0.6*"/>
                        <DataGridTextColumn Header="اسم الدواء" Binding="{Binding MED_NAME}" Width="2.5*"/>

                    </controls:PaginatedGridControl>
                </Grid>
            </GroupBox>

            <!-- ================= الجانب الأيسر: تفاصيل الجرعة والأدوية المضافة ================= -->
            <Grid Grid.Column="1" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- لوحة الجرعة والتعليمات -->
                <GroupBox Grid.Row="0" 
                          Header="تفاصيل الجرعة والإستخدام" 
                          FontWeight="Bold" 
                          Foreground="{StaticResource TextPrimaryBrush}" 
                          Background="{StaticResource SurfaceBrush}" 
                          BorderBrush="{StaticResource BorderBrush}" 
                          Margin="0,0,0,8" 
                          Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- اسم العلاج المحدد -->
                        <Border Grid.Row="0" Grid.ColumnSpan="2" 
                                Background="{StaticResource BgMainBrush}" 
                                BorderBrush="{StaticResource BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Padding="8,6" 
                                Margin="4,0,4,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="العلاج المحدد: " FontWeight="Bold" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedMedicationName, FallbackValue='لم يتم تحديد دواء بعد'}" 
                                           FontWeight="Bold" 
                                           Foreground="#007ACC" 
                                           FontSize="13" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- الكمية: إظهار النص العربي وحفظ الرقم الخالص -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="4">
                            <TextBlock Text="الكمية:" Margin="0,0,0,4" FontSize="11" Foreground="Gray"/>
                            <ComboBox ItemsSource="{Binding DosageAmounts}" 
                                      DisplayMemberPath="DisplayText"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedDosageAmount}" 
                                      IsEditable="True" 
                                      Height="32"/>
                        </StackPanel>

                        <!-- النوع -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="4">
                            <TextBlock Text="النوع:" Margin="0,0,0,4" FontSize="11" Foreground="Gray"/>
                            <ComboBox ItemsSource="{Binding DosageForms}" 
                                      DisplayMemberPath="DisplayText"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedDosageForm}" 
                                      IsEditable="True" 
                                      Height="32"/>
                        </StackPanel>

                        <!-- العدد -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="4">
                            <TextBlock Text="العدد:" Margin="0,0,0,4" FontSize="11" Foreground="Gray"/>
                            <ComboBox ItemsSource="{Binding DosageCounts}" 
                                      DisplayMemberPath="DisplayText"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedDosageCount}" 
                                      IsEditable="True" 
                                      Height="32"/>
                        </StackPanel>

                        <!-- الوقت -->
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="4">
                            <TextBlock Text="الوقت:" Margin="0,0,0,4" FontSize="11" Foreground="Gray"/>
                            <ComboBox ItemsSource="{Binding DosageTimings}" 
                                      DisplayMemberPath="DisplayText"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedDosageTiming}" 
                                      IsEditable="True" 
                                      Height="32"/>
                        </StackPanel>

                        <!-- أزرار التأكيد والإلغاء -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,8,4,4">
                            <Button Command="{Binding SaveDosageCommand}" Padding="12,5" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✅" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="تأكيد والإضافة" VerticalAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding CancelDosageCommand}" Padding="12,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✖️" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="إلغاء" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="1" 
          Header="الأدوية المضافة للزيارة الحالية" 
          FontWeight="Bold" 
          Foreground="{StaticResource TextPrimaryBrush}" 
          Background="{StaticResource SurfaceBrush}" 
          BorderBrush="{StaticResource BorderBrush}" 
          Padding="6">

                    <DataGrid ItemsSource="{Binding VisitMedicationsList}"
              SelectedItem="{Binding SelectedVisitMedication, Mode=TwoWay}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              IsReadOnly="True"
              SelectionMode="Single"
              GridLinesVisibility="Horizontal"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              Foreground="{StaticResource TextPrimaryBrush}">

                        <!-- استخدام ستايل متناسق لرؤوس الأعمدة والصفوف بناءً على ثيم النظام -->
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource BgMainBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الكود" Binding="{Binding MEDCHECK_CODE}" Width="0.6*"/>
                            <DataGridTextColumn Header="اسم الدواء" Binding="{Binding MEDCHECK_NAME}" Width="1.8*"/>
                            <DataGridTextColumn Header="تفاصيل الجرعة والتعليمات" Binding="{Binding MEDCHECK_NOTE}" Width="3*"/>
                        </DataGrid.Columns>

                    </DataGrid>
                </GroupBox>

            </Grid>
        </Grid>

        <customers:CustomerCard Grid.Row="2" 
                               DataContext="{Binding Customer}" 
                               Margin="0"
                               VerticalAlignment="Bottom"/>
    </Grid>
</Window>
