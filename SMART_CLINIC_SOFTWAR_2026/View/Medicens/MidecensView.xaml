<UserControl x:Class="SMART_CLINIC_SOFTWAR_2026.View.Medicens.MidecensView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Medicens"
             xmlns:vm="clr-namespace:SMART_CLINIC_SOFTWAR_2026.ViewModel.Medicens"
             xmlns:controls="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Resorsus.DataViews"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             FlowDirection="RightToLeft">

    <Grid Background="{StaticResource BgMainBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- الهيدر الرئيسي -->
        <Border Grid.Row="0" 
                Background="{StaticResource HeaderBgBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="10,8">
            <TextBlock Text="إضافة - تعديل الأدوية" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>

        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="410"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- القسم الأيمن: نموذج إدخال البيانات والأزرار -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" 
                          Header="بيانات الأدوية" 
                          FontWeight="Bold" 
                          Foreground="{StaticResource TextPrimaryBrush}" 
                          Background="{StaticResource SurfaceBrush}" 
                          BorderBrush="{StaticResource BorderBrush}" 
                          Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,4">

                            <!-- كود العلاج -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="كود العلاج" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>
                                <TextBox Grid.Column="1" Text="{Binding MED_CODE, UpdateSourceTrigger=PropertyChanged}" IsEnabled="False"/>
                            </Grid>

                            <!-- اسم العلاج -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="اسم العلاج" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>
                                <TextBox Grid.Column="1" Text="{Binding MED_NAME, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- الاسم العلمي -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="الاسم العلمي" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>
                                <TextBox Grid.Column="1" Text="{Binding MED_S_NAME, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- مصدر العلاج -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="مصدر العلاج" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>
                                <TextBox Grid.Column="1" Text="{Binding MED_SOURES, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- سعر العلاج -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="سعر العلاج" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>
                                <TextBox Grid.Column="1" Text="{Binding MED_PRICE, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:N2\}}"/>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>

                <Border Grid.Row="1" 
                        Background="{StaticResource HeaderBgBrush}" 
                        BorderBrush="{StaticResource BorderBrush}" 
                        BorderThickness="1" 
                        Margin="0,8,0,0" 
                        Padding="4">
                    <UniformGrid Columns="4" Rows="1">
                        <Button x:Name="BtnSave" 
                                Command="{Binding AddMedicineCommand}" 
                                Style="{StaticResource AccentButtonStyle}" 
                                Margin="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="💾" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                                <TextBlock Text="حفظ" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnEdit" 
                                Command="{Binding UpdateMedicineCommand}" 
                                Margin="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✏️" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="تعديل" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnDelete" 
                                Command="{Binding DeleteMedicineCommand}" 
                                Style="{StaticResource DangerButtonStyle}" 
                                Margin="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✖" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                                <TextBlock Text="حذف" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnClear" 
                                Command="{Binding ClearFieldsCommand}" 
                                Margin="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🧹" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="مسح" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Border>
            </Grid>

            <!-- القسم الأيسر: شريط البحث والجدول المرقّم -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" 
                            Command="{Binding ClearSearchCommand}"
                            Padding="10,4" 
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧹" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="مسح" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <TextBox Grid.Column="1" 
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" 
                             VerticalContentAlignment="Center" 
                             FontSize="13"
                             Background="{StaticResource SurfaceBrush}"
                             BorderBrush="{StaticResource BorderBrush}"/>
                </Grid>

                <!-- الجدول المرقّم المخصص -->
                <controls:PaginatedGridControl 
                             Grid.Row="1"
                             ItemsSource="{Binding MedicinesList}"
                             SelectedItem="{Binding SelectedMedicine, Mode=TwoWay}"
                             CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
                             TotalRows="{Binding TotalRows, Mode=TwoWay}"
                             NumberOfRows="{Binding PageSize, Mode=TwoWay}"
                             PageChangedCommand="{Binding PageChangedCommand}">

                    <DataGridTextColumn Header="الرقم" Binding="{Binding MED_ID}" Width="0.6*"/>
                    <DataGridTextColumn Header="كود العلاج" Binding="{Binding MED_CODE}" Width="0.8*"/>
                    <DataGridTextColumn Header="اسم العلاج" Binding="{Binding MED_NAME}" Width="2*"/>
                    <DataGridTextColumn Header="الاسم العلمي" Binding="{Binding MED_S_NAME}" Width="2*"/>
                    <DataGridTextColumn Header="المصدر" Binding="{Binding MED_SOURES}" Width="1.5*"/>
                    <DataGridTextColumn Header="السعر" Binding="{Binding MED_PRICE, StringFormat=\{0:N2\}}" Width="1*"/>

                </controls:PaginatedGridControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
