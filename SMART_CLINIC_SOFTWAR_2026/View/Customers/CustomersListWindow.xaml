<Window x:Class="SMART_CLINIC_SOFTWAR_2026.View.Customers.CustomersListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Customers"
        xmlns:vm="clr-namespace:SMART_CLINIC_SOFTWAR_2026.ViewModel.Customers"
        xmlns:controls="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Resorsus.DataViews"
        mc:Ignorable="d"
        x:Name="CustomersWin"
        Title="قائمة المرضى" 
        Height="550" 
        Width="950"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgMainBrush}">


    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- عنوان الشاشة -->
        <TextBlock Grid.Row="0" 
                   Text="قائمة المرضى / العملاء" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Foreground="{StaticResource TextPrimaryBrush}" 
                   Margin="0,0,0,12"/>

        <!-- شريط البحث ومسح البحث -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" 
                    Command="{Binding ClearSearchCommand}"
                    Padding="12,5" 
                    Margin="0,0,10,0"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🧹" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="مسح" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <Grid Grid.Column="1">
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Padding="30,6,8,6" 
                         VerticalContentAlignment="Center" 
                         FontSize="13"
                         Background="{StaticResource SurfaceBrush}"
                         BorderBrush="{StaticResource BorderBrush}"/>

                <TextBlock Text="🔍" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center" 
                           Margin="8,0,0,0" 
                           Foreground="Gray" 
                           IsHitTestVisible="False"/>

                <TextBlock Text="البحث باسم المريض أو الكود أو الهاتف أو العنوان..." 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center" 
                           Margin="32,0,0,0" 
                           Foreground="Gray" 
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <controls:PaginatedGridControl 
                     Grid.Row="2"
                     ItemsSource="{Binding CustomersList}"
                     SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                     CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
                     TotalRows="{Binding TotalRows, Mode=TwoWay}"
                     NumberOfRows="{Binding PageSize, Mode=TwoWay}"
                     PageChangedCommand="{Binding PageChangedCommand}"
                     RowDoubleClickCommand="{Binding SelectCustomerCommand}"
                     RowDoubleClickCommandParameter="{Binding ElementName=CustomersWin}">

            <DataGridTextColumn Header="كود المريض" Binding="{Binding CUST_CODE}" Width="0.8*"/>

            <DataGridTemplateColumn Header="اسم المريض" Width="2*">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} {1} {2} {3}">
                                    <Binding Path="CUST_F_NAME"/>
                                    <Binding Path="CUST_S_NAME"/>
                                    <Binding Path="CUST_T_NAME"/>
                                    <Binding Path="CUST_L_NAME"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="العمر" Binding="{Binding CUST_AGE}" Width="0.6*"/>
            <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding CUST_MOBILE1}" Width="1.2*"/>
            <DataGridTextColumn Header="العنوان" Binding="{Binding CUST_ADDRESS}" Width="1.5*"/>
            <DataGridTextColumn Header="حالة التأمين" Binding="{Binding CUST_SAVE_STATE}" Width="1*"/>

        </controls:PaginatedGridControl>
    </Grid>
</Window>
