<UserControl x:Class="SMART_CLINIC_SOFTWAR_2026.View.Customers.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Customers"
             xmlns:vm="clr-namespace:SMART_CLINIC_SOFTWAR_2026.ViewModel.Customers"
             xmlns:controls="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Resorsus.DataViews"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1100"
             FlowDirection="RightToLeft">



    <Grid Background="{StaticResource BgMainBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- الهيدر الرئيسي -->
        <Border Grid.Row="0" 
                Background="{StaticResource HeaderBgBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="10,8">
            <TextBlock Text="إدارة بيانات المرضى / العملاء" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>

        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- القسم الأيمن: نموذج إدخال البيانات والأزرار -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" 
                          Header="بيانات المريض" 
                          FontWeight="Bold" 
                          Foreground="{StaticResource TextPrimaryBrush}" 
                          Background="{StaticResource SurfaceBrush}" 
                          BorderBrush="{StaticResource BorderBrush}" 
                          Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,4">

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="كود المريض" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>
                                <TextBox Grid.Column="1" Text="{Binding CUST_CODE, UpdateSourceTrigger=PropertyChanged}" IsEnabled="False"/>
                            </Grid>

                            <!-- اسم المريض (4 حقول أفقية متجاورة) -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="اسم المريض *" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding CUST_F_NAME, UpdateSourceTrigger=PropertyChanged}" ToolTip="الاسم الأول"/>
                                    <TextBox Grid.Column="2" Text="{Binding CUST_S_NAME, UpdateSourceTrigger=PropertyChanged}" ToolTip="الاسم الثاني"/>
                                    <TextBox Grid.Column="4" Text="{Binding CUST_T_NAME, UpdateSourceTrigger=PropertyChanged}" ToolTip="الاسم الثالث"/>
                                    <TextBox Grid.Column="6" Text="{Binding CUST_L_NAME, UpdateSourceTrigger=PropertyChanged}" ToolTip="اللقب / العائلة"/>
                                </Grid>
                            </Grid>

                            <!-- العمر -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="العمر" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>
                                <TextBox Grid.Column="1" Text="{Binding CUST_AGE, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- تاريخ الميلاد -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="تاريخ الميلاد" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>
                                <DatePicker Grid.Column="1" SelectedDate="{Binding CUST_BD, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center"/>
                            </Grid>

                            <!-- رقم الهاتف -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="رقم الهاتف *" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding CUST_MOBILE1, UpdateSourceTrigger=PropertyChanged}" ToolTip="الهاتف الأول"/>
                                    <TextBox Grid.Column="2" Text="{Binding CUST_MOBILE2, UpdateSourceTrigger=PropertyChanged}" ToolTip="الهاتف الثاني"/>
                                </Grid>
                            </Grid>

                            <!-- العنوان -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="العنوان" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>
                                <TextBox Grid.Column="1" Text="{Binding CUST_ADDRESS, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- حالة التأمين -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="حالة التأمين" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>
                                <TextBox Grid.Column="1" Text="{Binding CUST_SAVE_STATE, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- بطاقة التأمين -->
                            <!-- بطاقة التأمين -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="بطاقة التأمين" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>

                                <!-- حقل القراءة فقط -->
                                <TextBox Grid.Column="1" 
                                        Text="{Binding CARD_ID, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" 
                                        IsReadOnly="True" 
                                        Background="#F4F4F4" 
                                        Focusable="False" Margin="0,0,10,0"/>
                                      
                                                           <!-- زر البحث واختيار البطاقة -->
                                                           <Button Grid.Column="2" 
                                       Command="{Binding OpenCardsWindowCommand}" 
                                       Content="🔍" 
                                       ToolTip="بحث واختيار بطاقة تأمين"/>
                            </Grid>


                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>

                <!-- أزرار العمليات السفلى -->
                <Border Grid.Row="1" 
                        Background="{StaticResource HeaderBgBrush}" 
                        BorderBrush="{StaticResource BorderBrush}" 
                        BorderThickness="1" 
                        Margin="0,8,0,0" 
                        Padding="4">
                    <UniformGrid Columns="4" Rows="1">
                        <Button x:Name="BtnSave" 
                                Command="{Binding AddCustomerCommand}" 
                                Style="{StaticResource AccentButtonStyle}" 
                                Margin="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="💾" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                                <TextBlock Text="حفظ" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnEdit" 
                                Command="{Binding UpdateCustomerCommand}" 
                                Margin="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✏️" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="تعديل" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnDelete" 
                                Command="{Binding DeleteCustomerCommand}" 
                                Style="{StaticResource DangerButtonStyle}" 
                                Margin="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✖" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                                <TextBlock Text="حذف" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnClear" 
                                Command="{Binding ClearFieldsCommand}" 
                                Margin="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🧹" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="مسح" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Border>
            </Grid>

            <!-- القسم الأيسر: شريط البحث والجدول (عرض الاسم الكامل بدلاً من الاسم الأول واللقب) -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- شريط البحث -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" 
                            Command="{Binding ClearSearchCommand}"
                            Padding="10,4" 
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧹" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="مسح" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <TextBox Grid.Column="1" 
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" 
                             VerticalContentAlignment="Center" 
                             FontSize="13"
                             Background="{StaticResource SurfaceBrush}"
                             BorderBrush="{StaticResource BorderBrush}"/>
                </Grid>

                <!-- الجدول المحسّن بالبيانات الأساسية فقط وعرض الاسم الكامل -->
                <controls:PaginatedGridControl 
                             Grid.Row="1"
                             ItemsSource="{Binding CustomersList}"
                             SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                             CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
                             TotalRows="{Binding TotalRows, Mode=TwoWay}"
                             NumberOfRows="{Binding PageSize, Mode=TwoWay}"
                             PageChangedCommand="{Binding PageChangedCommand}">

                    <DataGridTextColumn Header="كود المريض" Binding="{Binding CUST_CODE}" Width="0.8*"/>

                    <!-- عمود الاسم الكامل مدمج من الأجزاء الأربعة -->
                    <DataGridTemplateColumn Header="الاسم الكامل" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} {1} {2} {3}">
                                            <Binding Path="CUST_F_NAME"/>
                                            <Binding Path="CUST_S_NAME"/>
                                            <Binding Path="CUST_T_NAME"/>
                                            <Binding Path="CUST_L_NAME"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="العمر" Binding="{Binding CUST_AGE}" Width="0.6*"/>
                    <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding CUST_MOBILE1}" Width="1.2*"/>
                    <DataGridTextColumn Header="العنوان" Binding="{Binding CUST_ADDRESS}" Width="1.4*"/>
                    <DataGridTextColumn Header="حالة التأمين" Binding="{Binding CUST_SAVE_STATE}" Width="1*"/>

                </controls:PaginatedGridControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
