<UserControl x:Class="SMART_CLINIC_SOFTWAR_2026.View.Customers.CustomerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Customers"
             mc:Ignorable="d" 
             d:DesignHeight="230" d:DesignWidth="280"
             FlowDirection="RightToLeft">

    <Border Background="{StaticResource SurfaceBrush}" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="8" 
            Margin="0,8,0,0">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.05"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" 
                    Background="{StaticResource HeaderBgBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="0,0,0,1" 
                    CornerRadius="8,8,0,0" 
                    Padding="8,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="🪪" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="بطاقة المريض" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="كود: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding CUST_CODE, TargetNullValue='---'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="12">
                <Grid>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">

                        <TextBlock Text="الاسم:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} {1} {2}">
                                    <Binding Path="CUST_F_NAME"/>
                                    <Binding Path="CUST_T_NAME"/>
                                    <Binding Path="CUST_L_NAME"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="العمر:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding CUST_AGE, StringFormat='{}{0} سنة', TargetNullValue='--'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="الهاتف:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding CUST_MOBILE1, TargetNullValue='--'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,2,0,0">
                            <TextBlock Text="التأمين:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CUST_SAVE_STATE, TargetNullValue='غير مؤمن'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="2" 
                    Background="{StaticResource HeaderBgBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="0,1,0,0" 
                    CornerRadius="0,0,8,8" 
                    Padding="8,0">
                <Grid VerticalAlignment="Center">
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
