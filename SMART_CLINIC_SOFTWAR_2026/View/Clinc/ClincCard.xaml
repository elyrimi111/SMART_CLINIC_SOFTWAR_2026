<UserControl x:Class="SMART_CLINIC_SOFTWAR_2026.View.Clinc.ClincCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="150" 
             d:DesignWidth="250">

    <Border Background="{StaticResource SurfaceBrush}" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="8" 
            Margin="6" 
            Padding="12"
            Cursor="Hand">

        <Border.InputBindings>
            <MouseBinding MouseAction="LeftDoubleClick" 
                          Command="{Binding DataContext.SelectClinicCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                          CommandParameter="{Binding}"/>
        </Border.InputBindings>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="19*"/>
                <ColumnDefinition Width="87*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- رأس الكارت: اسم العيادة وكودها -->
            <Grid Grid.Row="0" Margin="0,0,0,10" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="{Binding CLI_NAME}" 
                           FontSize="15" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource TextPrimaryBrush}" 
                           TextTrimming="CharacterEllipsis"/>

                <Border Grid.Column="1" 
                        Background="{StaticResource BgMainBrush}" 
                        CornerRadius="4" 
                        Padding="6,2">
                    <TextBlock Text="{Binding CLI_CODE}" 
                               FontSize="11" 
                               FontWeight="SemiBold" 
                               Foreground="Gray"/>
                </Border>
            </Grid>

            <!-- تفاصيل الكارت: الموقع والملاحظات -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Grid.ColumnSpan="2">
                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="📍 " FontSize="12"/>
                    <TextBlock Text="{Binding CLI_LOC}" 
                               FontSize="12" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="📝 " FontSize="12"/>
                    <TextBlock Text="{Binding CLI_NOTE}" 
                               FontSize="11" 
                               Foreground="Gray" 
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
