<Window x:Class="SMART_CLINIC_SOFTWAR_2026.View.Clinc.ClincListWindowxaml"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Clinc"
        xmlns:vm="clr-namespace:SMART_CLINIC_SOFTWAR_2026.ViewModel.Clinc"
        xmlns:header="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Resorsus.Header"
        mc:Ignorable="d"
        x:Name="RootWindow"
        Title="عرض العيادات" 
        Height="650" Width="1050"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        FlowDirection="RightToLeft"
        Background="Transparent"
        AllowsTransparency="True">

    <Window.DataContext>
        <vm:ClincListWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="GlassCardBg" Color="#EAFFFFFF"/>
        <SolidColorBrush x:Key="GlassBorderBrush" Color="#B8D5D8"/>
    </Window.Resources>

    <Border BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1.5" CornerRadius="12" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <header:MainHeader Grid.Row="0" Title="دليل العيادات - SMART CLINIC 2026"/>

            <Grid Grid.Row="1">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F4F8F8" Offset="0.0"/>
                        <GradientStop Color="#F4F8F8" Offset="0.45"/>
                        <GradientStop Color="#2C7A7B" Offset="0.451"/>
                        <GradientStop Color="#1A5354" Offset="1.0"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <Border Background="{StaticResource GlassCardBg}" 
                        BorderBrush="{StaticResource GlassBorderBrush}" 
                        BorderThickness="1.5" 
                        CornerRadius="14"
                        Margin="20"
                        Padding="16">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="6" BlurRadius="20" Opacity="0.15"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- عرض قائمة العيادات عبر شبكة منتظمة لتعبئة الفراغ -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ClinicsList}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" VerticalAlignment="Top"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:ClincCard Height="140" HorizontalAlignment="Stretch"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- التذييل -->
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="{Binding TotalClinicsCountText, FallbackValue='إجمالي العيادات المسجلة: 0'}" 
                                       FontSize="11" FontWeight="Bold" Foreground="#2C7A7B" VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1" 
                                       Text="جميع الحقوق محفوظة للمهندس محمد فؤاد اليريمي © 2026" 
                                       FontSize="10" Foreground="#718096" VerticalAlignment="Center"/>
                        </Grid>

                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
