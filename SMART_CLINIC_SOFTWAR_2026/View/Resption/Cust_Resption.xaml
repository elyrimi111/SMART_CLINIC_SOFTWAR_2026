<UserControl x:Class="SMART_CLINIC_SOFTWAR_2026.View.Resption.Cust_Resption"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Resption"
             xmlns:cust="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Customers"
             xmlns:controls="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Resorsus.DataViews"
             xmlns:vm="clr-namespace:SMART_CLINIC_SOFTWAR_2026.ViewModel.Orders"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1100"
             FlowDirection="RightToLeft">

    <UserControl.DataContext>
        <vm:OrdersViewModel/>
    </UserControl.DataContext>

    <Grid Background="{StaticResource BgMainBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- الهيدر الرئيسي -->
        <Border Grid.Row="0" 
                Background="{StaticResource HeaderBgBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="10,8">
            <TextBlock Text="استقبال المرضى" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>

        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- اللوحة الجانبية: تفاصيل الطلب والخدمات -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="بيانات زيارة الكشف" 
                                  FontWeight="Bold" 
                                  Foreground="{StaticResource TextPrimaryBrush}" 
                                  Background="{StaticResource SurfaceBrush}" 
                                  BorderBrush="{StaticResource BorderBrush}" 
                                  Padding="10"
                                  Margin="0,0,0,10">
                            <StackPanel>

                                <TextBlock Text="المريض المحدد:" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                                <Border Background="{StaticResource BgMainBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding CUST_NAME, TargetNullValue='لم يتم تحديد مريض بعد'}" 
                                               FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBrush}"/>
                                </Border>

                                <TextBlock Text="كود طلب الزياره:" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ORDER_CODE, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         Padding="6" Margin="0,0,0,10" IsReadOnly="True" Background="{StaticResource BgMainBrush}"/>

                                <TextBlock Text="  ملاحظات طلب: الزياره" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ORDER_NOTE, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         Padding="6" Margin="0,0,0,10" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

                                <Button Command="{Binding AddOrderCommand}" 
                                        Height="40" 
                                        Style="{StaticResource AccentButtonStyle}" 
                                        Margin="0,4,0,4"
                                        ToolTip="إضافة طلب جديد للمريض المحدد">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="➕" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                                        <TextBlock Text="إضافة طلب  زيارة جديد" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ClearFieldsCommand}" 
                                        Height="36" 
                                        Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="🔄" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="تفريغ الخانات" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="الخدمات" 
                                  FontWeight="Bold" 
                                  Foreground="{StaticResource TextPrimaryBrush}" 
                                  Background="{StaticResource SurfaceBrush}" 
                                  BorderBrush="{StaticResource BorderBrush}" 
                                  Padding="8">
                            <StackPanel>
                                <Button Command="{Binding OpenPatientManagementCommand}" 
                                        Height="44" 
                                        Margin="0,0,0,6"
                                        Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="👤" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                                        <TextBlock Text="إضافة / تعديل سجل مريض" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- المنطقة الرئيسية: جدول المرضى وجدول الطلبات -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <!-- جدول اختيار المرضى -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                Command="{Binding ClearSearchCommand}"
                                Padding="10,4" 
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧹" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="مسح البحث" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBox Grid.Column="1" 
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" 
                                 VerticalContentAlignment="Center" 
                                 FontSize="13"
                                 Background="{StaticResource SurfaceBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"/>
                    </Grid>

                    <controls:PaginatedGridControl
                                     ItemsSource="{Binding CustList}"
                                     SelectedItem="{Binding SelectedPatient, Mode=TwoWay}"
                                     CurrentPage="{Binding CustCurrentPage, Mode=TwoWay}"
                                     TotalRows="{Binding TotalCustRows, Mode=TwoWay}"
                                     NumberOfRows="{Binding PageSize, Mode=TwoWay}"
                                     PageChangedCommand="{Binding CustPageChangedCommand}" Margin="0,39,0,10" Grid.RowSpan="2">

                        <DataGridTextColumn Header="رقم المريض" Binding="{Binding CUST_ID}" Width="0.8*"/>

                        <DataGridTemplateColumn Header="اسم المريض" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1} {2}">
                                                <Binding Path="CUST_F_NAME"/>
                                                <Binding Path="CUST_S_NAME"/>
                                                <Binding Path="CUST_L_NAME"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="الهاتف" Binding="{Binding CUST_MOBILE1}" Width="1.2*"/>

                    </controls:PaginatedGridControl>
                </Grid>

                <!-- شريط أزرار عمليات الطلب SelectedOrder -->
                <Grid Grid.Row="1" Margin="0,21,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding UpdateOrderCommand}" 
                                Padding="12,6" Margin="4,0"
                                ToolTip="تحديث بيانات الطلب المحدد">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✏️" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="تعديل الطلب" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding DeleteOrderCommand}" 
                                Style="{StaticResource DangerButtonStyle}" 
                                Padding="12,6" Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑️" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                                <TextBlock Text="حذف الطلب" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <GroupBox Grid.Row="2" 
                          Header="قائمة الانتظار الحالية" 
                          FontWeight="Bold" 
                          Foreground="{StaticResource TextPrimaryBrush}" 
                          Background="{StaticResource SurfaceBrush}" 
                          BorderBrush="{StaticResource BorderBrush}" 
                          Padding="4">
                    <DataGrid ItemsSource="{Binding OrdersList}" 
                              SelectedItem="{Binding SelectedOrder, Mode=TwoWay}" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              Background="{StaticResource SurfaceBrush}"
                              RowBackground="{StaticResource SurfaceBrush}"
                              AlternatingRowBackground="{StaticResource BgMainBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource BorderBrush}">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource HeaderBgBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="كود" Binding="{Binding ORDER_CODE}" Width="0.8*"/>
                            <DataGridTextColumn Header="تاريخ" Binding="{Binding ORDER_DATE, StringFormat=\{0:yyyy/MM/dd\}}" Width="1*"/>
                            <DataGridTextColumn Header="الوقت" Binding="{Binding ORDER_TIME, StringFormat={}{0:hh\\:mm}}" Width="0.8*"/>
                            <DataGridTextColumn Header="رقم المريض" Binding="{Binding CUST_ID}" Width="0.8*"/>
                            <DataGridTextColumn Header="اسم المريض" Binding="{Binding CUST_NAME}" Width="1.0*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

            </Grid>
        </Grid>
    </Grid>
</UserControl>
