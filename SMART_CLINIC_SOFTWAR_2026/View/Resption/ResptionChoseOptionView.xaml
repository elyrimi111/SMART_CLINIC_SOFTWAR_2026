<UserControl x:Class="SMART_CLINIC_SOFTWAR_2026.View.Resption.ResptionChoseOptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Resption"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1150"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <!-- الأيقونات المحلّية الخاصة بالتوجيه -->
        <StreamGeometry x:Key="IconCalendar">M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z</StreamGeometry>
        <StreamGeometry x:Key="IconArrowLeft">M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z</StreamGeometry>
        <StreamGeometry x:Key="IconPlus">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
        <StreamGeometry x:Key="IconChart">M19,3H5C3.9,3 3,3.9 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.9 20.1,3 19,3M9,17H7V10H9V17M13,17H11V7H13V17M17,17H15V13H17V17Z</StreamGeometry>
    </UserControl.Resources>

    <!-- أنميشن تحميل مساحة العمل -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInSlideUpStoryboard}" 
                             Storyboard.TargetName="ErpWorkspaceGrid"/>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Background="{StaticResource BgMainBrush}">
        <!-- شبكة مساحة العمل (ERP Workspace Grid) مُتمركزة بوسط الشاشة بالكامل -->
        <Grid x:Name="ErpWorkspaceGrid" 
              Width="980" 
              Height="480" 
              HorizontalAlignment="Center" 
              VerticalAlignment="Center">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <!-- ================= 1. وحدة: استقبال وتسجيل المرضى ================= -->
            <Border Grid.Row="0" Grid.Column="0" 
                    Background="{StaticResource SurfaceBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="14" 
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource HeaderBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                                <Path Data="{StaticResource IconUser}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="إدارة الاستقبال" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Patient Reception" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10">
                        <TextBlock Text="تسجيل دخول المرضى الجدد والمترددين، معالجة طلبات الزيارة وإدارتهم في لائحة الانتظار." 
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="19"/>
                    </StackPanel>

                    <Button Grid.Row="2" 
                            Command="{Binding OpenPatientReceptionCommand}"
                            Style="{StaticResource AnimatedOptionCardStyle}"
                            Padding="14,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Path Data="{StaticResource IconPlus}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="فتح شاشة الاستقبال" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <Path Data="{StaticResource IconArrowLeft}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <!-- ================= 2. وحدة: حجز المواعيد والجدولة ================= -->
            <Border Grid.Row="0" Grid.Column="2" 
                    Background="{StaticResource SurfaceBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="14" 
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource HeaderBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                                <Path Data="{StaticResource IconCalendar}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="جدولة المواعيد" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Appointment Booking" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10">
                        <TextBlock Text="تنسيق حجوزات العيادات المسبقة، جدولة مواعيد الأطباء، وتأكيد الحضور والغياب." 
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="19"/>
                    </StackPanel>

                    <Button Grid.Row="2" 
                            Command="{Binding OpenAppointmentBookingCommand}"
                            Style="{StaticResource AnimatedOptionCardStyle}"
                            Padding="14,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Path Data="{StaticResource IconPlus}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="حجز موعد جديد" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <Path Data="{StaticResource IconArrowLeft}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <!-- ================= 3. وحدة: تسجيل وإدخال الكشف ================= -->
            <Border Grid.Row="2" Grid.Column="0" 
                    Background="{StaticResource SurfaceBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="14" 
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource HeaderBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                                <Path Data="{StaticResource IconStethoscope}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="الفحص الأولـي" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Triage &amp; Examination" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10">
                        <TextBlock Text="تسجيل العلامات الحيوية، الفحوصات الأولية للكشف، وتحويل المريض مباشرة للعيادة." 
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="19"/>
                    </StackPanel>

                    <Button Grid.Row="2" 
                            Command="{Binding OpenExaminationEntryCommand}"
                            Style="{StaticResource AnimatedOptionCardStyle}"
                            Padding="14,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Path Data="{StaticResource IconPlus}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="بدء إدخال كشف" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <Path Data="{StaticResource IconArrowLeft}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <!-- ================= 4. لوحة الإحصائيات الحية (ERP Metrics Tile) ================= -->
            <Border Grid.Row="2" Grid.Column="2" 
                    Background="{StaticResource HeaderBgBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="14" 
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Path Data="{StaticResource IconChart}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="مؤشرات حركة اليوم" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="0,12,0,0">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="4" Padding="12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="إجمالي الزيارات" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="--" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="4" Padding="12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="المواعيد المؤكدة" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="--" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="4" Padding="12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="قائمة الانتظار" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="--" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="4" Padding="12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="الكشوفات المكتملة" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="--" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
