<Window x:Class="SMART_CLINIC_SOFTWAR_2026.View.Company.ComapanyesListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Company"
        xmlns:vm="clr-namespace:SMART_CLINIC_SOFTWAR_2026.ViewModel.Company"
        xmlns:controls="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Resorsus.DataViews"
        mc:Ignorable="d"
        Title="قائمة الشركات" 
        Height="550" 
        Width="900"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgMainBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="قائمة الشركات" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Foreground="{StaticResource TextPrimaryBrush}" 
                   Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" 
                    Command="{Binding ClearSearchCommand}"
                    Padding="12,5" 
                    Margin="0,0,10,0"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🧹" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="مسح" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <Grid Grid.Column="1">
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Padding="30,6,8,6" 
                         VerticalContentAlignment="Center" 
                         FontSize="13"
                         Background="{StaticResource SurfaceBrush}"
                         BorderBrush="{StaticResource BorderBrush}"/>

                <TextBlock Text="🔍" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center" 
                           Margin="8,0,0,0" 
                           Foreground="Gray" 
                           IsHitTestVisible="False"/>

                <TextBlock Text="البحث باسم الشركة أو رقم الهاتف..." 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center" 
                           Margin="32,0,0,0" 
                           Foreground="Gray" 
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <controls:PaginatedGridControl 
                     Grid.Row="2"
                     ItemsSource="{Binding CompaniesList}"
                     SelectedItem="{Binding SelectedCompany, Mode=TwoWay}"
                     CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
                     TotalRows="{Binding TotalRows, Mode=TwoWay}"
                     NumberOfRows="{Binding PageSize, Mode=TwoWay}"
                     PageChangedCommand="{Binding PageChangedCommand}">

            <DataGridTextColumn Header="كود الشركة" Binding="{Binding COM_CODE}" Width="1*"/>
            <DataGridTextColumn Header="اسم الشركة" Binding="{Binding COM_NAME}" Width="2.5*"/>
            <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding COM_MOBILE}" Width="1.5*"/>
            <DataGridTextColumn Header="العنوان" Binding="{Binding COM_ADDRESS}" Width="2*"/>
            <DataGridTextColumn Header="حالة الشركة" Binding="{Binding COM_STATE}" Width="1*"/>

        </controls:PaginatedGridControl>
    </Grid>
</Window>
