<Window x:Class="SMART_CLINIC_SOFTWAR_2026.View.Diagnose.DiagnosisFromVisitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Diagnose"
        xmlns:customers="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Customers"
        xmlns:controls="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Resorsus.DataViews"
        xmlns:header="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Resorsus.Header"
        mc:Ignorable="d"
        Title="التشخيص في الزيارة" 
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft">

    <Grid Background="{StaticResource BgMainBrush}">
        <Grid.RowDefinitions>
            <!-- 1. الهيدر الرئيسي -->
            <RowDefinition Height="Auto"/>
            <!-- 2. شريط أزرار العمليات الموحد -->
            <RowDefinition Height="Auto"/>
            <!-- 3. الجزء الرئيسي (الجداول وبطاقة المريض) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. الهيدر الرئيسي -->
        <header:MainHeader Grid.Row="0" Title="التشخيص من الكشف"/>

        <!-- 2. شريط العمليات والأزرار العلوية (يمتد بملء الشاشة) -->
        <Border Grid.Row="1" 
                Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="10,6"
                Margin="8,8,8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- أزرار الإضافة والتصفح -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnNewDiagnosis" 
                            Command="{Binding NewDiagnosisCommand}" 
                            Style="{StaticResource AccentButtonStyle}" 
                            Padding="14,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                            <TextBlock Text="تشخيص جديد" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnPreviousDiagnosis" 
                            Command="{Binding PreviousDiagnosisCommand}" 
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="تشخيص سابق" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- أزرار الحذف -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnDelete" 
                            Command="{Binding DeleteCommand}" 
                            Style="{StaticResource DangerButtonStyle}" 
                            Margin="0,0,8,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✖" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                            <TextBlock Text="حذف" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnDeleteAll" 
                            Command="{Binding DeleteAllCommand}" 
                            Style="{StaticResource DangerButtonStyle}" 
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑️" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                            <TextBlock Text="حذف الكل" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. المحتوى الرئيسي: الجداول مقسمة مع وضع البطاقة تحت جدول تشخيصات الزيارة -->
        <Grid Grid.Row="2" Margin="8,4,8,8">
            <Grid.ColumnDefinitions>
                <!-- العمود الأيمن: قائمة التشخيصات العامة (تأخذ المساحة الكاملة ارتفاعاً) -->
                <ColumnDefinition Width="1.2*"/>
                <!-- العمود الأيسر: تشخيصات الزيارة + البطاقة بالأسفل -->
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- العمود الأول: القائمة العامة للتشخيصات -->
            <GroupBox Grid.Column="0" 
                      Header="قائمة التشخيصات العامة" 
                      FontWeight="Bold" 
                      Foreground="{StaticResource TextPrimaryBrush}" 
                      Background="{StaticResource SurfaceBrush}" 
                      BorderBrush="{StaticResource BorderBrush}" 
                      Margin="0,0,4,0" 
                      Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- شريط البحث -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" 
                                 Text="{Binding SearchDiagnosisQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" 
                                 VerticalContentAlignment="Center" 
                                 FontSize="13"
                                 Background="{StaticResource SurfaceBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"/>

                        <Button Grid.Column="1" 
                                Command="{Binding ClearSearchCommand}"
                                Padding="10,5" 
                                Margin="6,0,0,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧹" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="مسح" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- جدول البيانات الرئيسي الممتد -->
                    <controls:PaginatedGridControl 
                             Grid.Row="1"
                             ItemsSource="{Binding AllDiagnosesList}"
                             SelectedItem="{Binding SelectedAllDiagnosis, Mode=TwoWay}"
                             CurrentPage="{Binding AllDiagnosesCurrentPage, Mode=TwoWay}"
                             TotalRows="{Binding AllDiagnosesTotalRows, Mode=TwoWay}"
                             NumberOfRows="{Binding AllDiagnosesPageSize, Mode=TwoWay}"
                             PageChangedCommand="{Binding AllDiagnosesPageChangedCommand}">

                        <DataGridTextColumn Header="الرقم" Binding="{Binding DIG_CODE}" Width="0.8*"/>
                        <DataGridTextColumn Header="اسم التشخيص" Binding="{Binding DIG_NAME}" Width="2*"/>
                        <DataGridTextColumn Header="نوع التشخيص" Binding="{Binding DIG_TYPE}" Width="1.3*"/>

                    </controls:PaginatedGridControl>
                </Grid>
            </GroupBox>

            <!-- العمود الثاني: تشخيصات الزيارة الحالية وفي أسفلها البطاقة -->
            <Grid Grid.Column="1" Margin="4,0,0,0">
                <Grid.RowDefinitions>
                    <!-- جدول تشخيصات الزيارة يأخذ معظم المساحة العلويّة -->
                    <RowDefinition Height="*"/>
                    <!-- بطاقة المريض مثبتة في الأسفل تماماً -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. تشخيصات الزيارة الحالية -->
                <GroupBox Grid.Row="0" 
                          Header="تشخيصات الزيارة الحالية" 
                          FontWeight="Bold" 
                          Foreground="{StaticResource TextPrimaryBrush}" 
                          Background="{StaticResource SurfaceBrush}" 
                          BorderBrush="{StaticResource BorderBrush}" 
                          Margin="0,0,0,6" 
                          Padding="6">

                    <controls:PaginatedGridControl 
                                 ItemsSource="{Binding VisitDiagnosesList}"
                                 SelectedItem="{Binding SelectedVisitDiagnosis, Mode=TwoWay}"
                                 CurrentPage="{Binding VisitPage, Mode=TwoWay}"
                                 TotalRows="{Binding VisitTotalRows, Mode=TwoWay}"
                                 NumberOfRows="{Binding VisitPageSize, Mode=TwoWay}"
                                 PageChangedCommand="{Binding VisitPageChangedCommand}">

                        <DataGridTextColumn Header="الرقم" Binding="{Binding DIG_CODE}" Width="0.8*"/>
                        <DataGridTextColumn Header="اسم التشخيص" Binding="{Binding DIG_NAME}" Width="2*"/>
                        <DataGridTextColumn Header="نوع التشخيص" Binding="{Binding DIG_TYPE}" Width="1.3*"/>

                    </controls:PaginatedGridControl>
                </GroupBox>

                <!-- 2. بطاقة المريض في الأسفل تماماً تحت جدول تشخيصات الزيارة -->
                <customers:CustomerCard Grid.Row="1" 
                                       DataContext="{Binding Customer}" 
                                       Margin="0"
                                       VerticalAlignment="Bottom"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
