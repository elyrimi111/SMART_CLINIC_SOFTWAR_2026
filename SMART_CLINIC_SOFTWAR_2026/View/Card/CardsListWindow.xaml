<Window x:Class="SMART_CLINIC_SOFTWAR_2026.View.Card.CardsListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Resorsus.DataViews"
        mc:Ignorable="d"
        Title="قائمة بطاقات التأمين" 
        Height="550" 
        Width="900"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgMainBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="قائمة بطاقات التأمين" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Foreground="{StaticResource TextPrimaryBrush}" 
                   Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" 
                    Command="{Binding ClearSearchCommand}"
                    Padding="12,5" 
                    Margin="0,0,10,0"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🧹" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="مسح" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <Grid Grid.Column="1">
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Padding="30,6,8,6" 
                         VerticalContentAlignment="Center" 
                         FontSize="13"
                         Background="{StaticResource SurfaceBrush}"
                         BorderBrush="{StaticResource BorderBrush}"/>

                <TextBlock Text="🔍" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray" IsHitTestVisible="False"/>

                <TextBlock Text="البحث باسم البطاقة أو الكود أو الملاحظات..." 
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="32,0,0,0" Foreground="Gray" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <controls:PaginatedGridControl 
             Grid.Row="2"
             ItemsSource="{Binding CardsList}"
             SelectedItem="{Binding SelectedCard, Mode=TwoWay}"
             CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
             TotalRows="{Binding TotalRows, Mode=TwoWay}"
             NumberOfRows="{Binding PageSize, Mode=TwoWay}"
             PageChangedCommand="{Binding PageChangedCommand}"
             RowDoubleClickCommand="{Binding SelectCardCommand}"
             RowDoubleClickCommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">

            <DataGridTextColumn Header="كود البطاقة" Binding="{Binding CARD_CODE}" Width="0.8*"/>
            <DataGridTextColumn Header="اسم البطاقة" Binding="{Binding CARD_NAME}" Width="2*"/>
            <DataGridTextColumn Header="تاريخ الصلاحية" Binding="{Binding CARD_DATE}" Width="1.2*"/>
            <DataGridTextColumn Header="الحالة" Binding="{Binding CARD_STATE}" Width="0.8*"/>
            <DataGridTextColumn Header="نسبة التأمين" Binding="{Binding CARD_PER}" Width="1*"/>
            <DataGridTextColumn Header="ملاحظات" Binding="{Binding CARD_NOTE}" Width="1.8*"/>

        </controls:PaginatedGridControl>

    </Grid>
</Window>
