<UserControl x:Class="SMART_CLINIC_SOFTWAR_2026.View.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Dashboard"
             mc:Ignorable="d" 
             FlowDirection="RightToLeft"
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Background="{StaticResource BgMainBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">

                <Border Background="{StaticResource HeaderBgBrush}" 
                        BorderBrush="{StaticResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Padding="30,10" 
                        HorizontalAlignment="Center" 
                        Margin="0,0,0,40">
                    <TextBlock Text="{Binding CLI_NAME, FallbackValue='عيادة الطب العام'}" 
                               FontSize="26" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- 2. شبكة الكروت الرئيسية -->
                <Grid Width="850">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- العمود الأيمن: 4 كروت مرتبة في شبكة 2x2 -->
                    <UniformGrid Grid.Column="0" Columns="2" Rows="2">

                        <!-- كارت 1: المرضى في الانتظار -->
                        <Border Style="{StaticResource ErpCardStyle}" Margin="5" Padding="15">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="المرضى في الانتظار" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding WaitingPatientsCount, FallbackValue='0'}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource HeaderBgBrush}" Width="45" Height="45" CornerRadius="22.5">
                                    <Path Data="{StaticResource IconUser}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>


                        <Border Style="{StaticResource ErpCardStyle}" Margin="5" Padding="15">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="المستخدم الحالي" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentUser.USER_NAME, FallbackValue='Admin'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource HeaderBgBrush}" Width="45" Height="45" CornerRadius="22.5">
                                    <Path Data="{StaticResource IconStethoscope}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ErpCardStyle}" Margin="5" Padding="15">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="مواعيد اليوم" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TodayAppointmentsCount, FallbackValue='0'}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource HeaderBgBrush}" Width="45" Height="45" CornerRadius="22.5">
                                    <TextBlock Text="📅" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ErpCardStyle}" Margin="5" Padding="15">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='{}{0:dd/MM/yyyy}'}" 
                                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='{}{0:tt hh:mm}'}" 
                                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <Border Grid.Column="2" Style="{StaticResource ErpCardStyle}" Margin="5" Padding="20">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CompanyName, FallbackValue='Smart Clinic Software'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                            <TextBlock Text="{Binding CompanyAddress, FallbackValue='Yemen, Sanaa'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding CompanyPhone, FallbackValue='962788315151'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding CompanyEmail, FallbackValue='Info.smartsoftwareco@gmail.com'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
