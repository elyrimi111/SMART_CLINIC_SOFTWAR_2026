<UserControl x:Class="SMART_CLINIC_SOFTWAR_2026.View.Users.UsersChoseOptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Users"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1150"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <StreamGeometry x:Key="IconPlus">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
        <StreamGeometry x:Key="IconArrowLeft">M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z</StreamGeometry>
        <StreamGeometry x:Key="IconChart">M19,3H5C3.9,3 3,3.9 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.9 20.1,3 19,3M9,17H7V10H9V17M13,17H11V7H13V17M17,17H15V13H17V17Z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeInSlideUpStoryboard}" 
                             Storyboard.TargetName="ErpWorkspaceGrid"/>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Background="{StaticResource BgMainBrush}">
        <Grid x:Name="ErpWorkspaceGrid" 
              Width="980" 
              Height="480" 
              HorizontalAlignment="Center" 
              VerticalAlignment="Center">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0" 
                    Background="{StaticResource SurfaceBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="14" 
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource HeaderBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                                <Path Data="{StaticResource IconUser}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="قائمة المستخدمين" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Users Directory" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10">
                        <TextBlock Text="عرض وإدارة بيانات مستخدمي النظام، استعراض الحسابات النشطة، والتنقل بين سجلات الموظفين." 
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="19"/>
                    </StackPanel>

                    <Button Grid.Row="2" 
                            Command="{Binding OpenUsersListCommand}"
                            Style="{StaticResource AnimatedOptionCardStyle}"
                            Padding="14,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Path Data="{StaticResource IconPlus}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="فتح جدول المستخدمين" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <Path Data="{StaticResource IconArrowLeft}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.Column="2" 
                    Background="{StaticResource SurfaceBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="14" 
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource HeaderBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                                <Path Data="{StaticResource IconLock}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="إدارة الحسابات" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Account Management" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10">
                        <TextBlock Text="إنشاء حسابات مستخدمين جديدة، تعيين كلمات المرور، تحديث البيانات الشخصية ومعلومات الدخول." 
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="19"/>
                    </StackPanel>

                    <Button Grid.Row="2" 
                            Command="{Binding OpenManageAccountCommand}"
                            Style="{StaticResource AnimatedOptionCardStyle}"
                            Padding="14,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Path Data="{StaticResource IconPlus}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="إضافة / تعديل مستخدم" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <Path Data="{StaticResource IconArrowLeft}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="2" Grid.Column="0" 
                    Background="{StaticResource SurfaceBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="14" 
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource HeaderBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                                <Path Data="{StaticResource IconStethoscope}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="الأدوار والصلاحيات" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Roles &amp; Permissions" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10">
                        <TextBlock Text="تحديد مستويات الوصول وإسناد الصلاحيات للوظائف المختلفة (أطباء، موظفي استقبال، إدارة)." 
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="19"/>
                    </StackPanel>

                    <Button Grid.Row="2" 
                            Command="{Binding OpenRolesPermissionsCommand}"
                            Style="{StaticResource AnimatedOptionCardStyle}"
                            Padding="14,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Path Data="{StaticResource IconPlus}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="إدارة الصلاحيات" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <Path Data="{StaticResource IconArrowLeft}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="2" Grid.Column="2" 
                    Background="{StaticResource HeaderBgBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="14" 
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Path Data="{StaticResource IconChart}" Fill="{StaticResource PrimaryBrush}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="إحصائيات الحسابات" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="0,12,0,0">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="4" Padding="12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="إجمالي المستخدمين" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="--" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="4" Padding="12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="الحسابات النشطة" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="--" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="4" Padding="12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="المتصلون الآن" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="--" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="4" Padding="12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="الأدوار المعرفة" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="--" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
