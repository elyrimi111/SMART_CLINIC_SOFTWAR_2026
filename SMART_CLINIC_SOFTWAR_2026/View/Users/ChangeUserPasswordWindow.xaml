<Window x:Class="SMART_CLINIC_SOFTWAR_2026.View.Users.ChangeUserPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SMART_CLINIC_SOFTWAR_2026.ViewModel.Users"
        xmlns:header="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Resorsus.Header"
        mc:Ignorable="d"
        Title="تغيير كلمة المرور" 
        Height="360" Width="620"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="Transparent"
        FontFamily="{StaticResource AppFontFamily}">

    <Window.Resources>
        <vm:MultiPasswordBoxConverter x:Key="MultiPasswordBoxConverter"/>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceBrush}" 
            BorderBrush="{StaticResource PrimaryDarkBrush}" 
            BorderThickness="2" 
            CornerRadius="8"
            Margin="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <header:MainHeader Grid.Row="0" Title="تغيير كلمة المرور"/>

            <Grid Grid.Row="1" Margin="12,10,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PrimaryDarkBrush}" CornerRadius="6" Padding="12">
                    <StackPanel VerticalAlignment="Center">
                        <Border Width="44" Height="44" Background="{StaticResource PrimaryBrush}" CornerRadius="22" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Path Data="{StaticResource IconUser}" Fill="{StaticResource TextWhiteBrush}" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="{Binding CurrentUser.USER_NAME}" 
                                   Foreground="{StaticResource TextWhiteBrush}" 
                                   FontSize="13" FontWeight="Bold" 
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,2"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="المعرف: " Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding CurrentUser.USER_ID, FallbackValue='0'}" Foreground="{StaticResource TextWhiteBrush}" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.3" Margin="0,0,0,10"/>

                        <Border x:Name="PnlStatus" CornerRadius="4" Padding="6,4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#33FFFFFF"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentPasswordVerified}" Value="True">
                                            <Setter Property="Background" Value="#1B7B82"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock TextAlignment="Center" FontSize="10" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Text" Value="🔒 بانتظار التحقق..."/>
                                        <Setter Property="Foreground" Value="{StaticResource TextWhiteBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentPasswordVerified}" Value="True">
                                                <Setter Property="Text" Value="✓ تم التحقق بنجاح"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource HeaderBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="10" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock Text="1. كلمة المرور الحالية" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <PasswordBox x:Name="TxtCurrentPassword" Grid.Column="0" Height="30"/>

                                <Button Grid.Column="2" 
                                    Style="{StaticResource AccentButtonStyle}" 
                                    Height="30" 
                                    Command="{Binding VerifyPasswordCommand}" 
                                    CommandParameter="{Binding ElementName=TxtCurrentPassword}">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                                            <TextBlock Text="تحقق" Foreground="{StaticResource TextWhiteBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>

                            </Grid>
                        </StackPanel>

                        <Border Grid.Row="2" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>


                        <StackPanel Grid.Row="3" IsEnabled="{Binding IsCurrentPasswordVerified}" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="2. كلمة المرور الجديدة" Style="{StaticResource FieldLabelStyle}"/>
                                <PasswordBox x:Name="TxtNewPassword" Height="30"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,0">
                                <TextBlock Text="تأكيد كلمة المرور الجديدة" Style="{StaticResource FieldLabelStyle}"/>
                                <PasswordBox x:Name="TxtConfirmPassword" Height="30"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="12,4,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        Style="{StaticResource AccentButtonStyle}" 
                        Height="36"
                        Command="{Binding SavePasswordCommand}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z" 
                                  Fill="{StaticResource TextWhiteBrush}" 
                                  Width="13" Height="13" 
                                  Stretch="Uniform" 
                                  Margin="0,0,6,0" 
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="حفظ التغييرات" Foreground="{StaticResource TextWhiteBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                    <Button.CommandParameter>
                        <MultiBinding Converter="{StaticResource MultiPasswordBoxConverter}">
                            <Binding ElementName="TxtNewPassword"/>
                            <Binding ElementName="TxtConfirmPassword"/>
                        </MultiBinding>
                    </Button.CommandParameter>
                </Button>

                <Button Grid.Column="2" 
                        Content="إلغاء الأمر" 
                        Height="36"
                        FontWeight="Bold"
                        Command="{Binding CloseWindowCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
