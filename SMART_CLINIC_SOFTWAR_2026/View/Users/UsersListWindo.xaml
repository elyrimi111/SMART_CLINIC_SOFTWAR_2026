<Window x:Class="SMART_CLINIC_SOFTWAR_2026.View.Users.UsersListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Users"
        xmlns:vm="clr-namespace:SMART_CLINIC_SOFTWAR_2026.ViewModel.Users"
        xmlns:controls="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Resorsus.DataViews"
        mc:Ignorable="d"
        Title="قائمة المستخدمين" 
        Height="520" 
        Width="800"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgMainBrush}">

    <Window.DataContext>
        <vm:UsersListViewModel />
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- 0. العنوان العلوي -->
            <RowDefinition Height="Auto"/>
            <!-- 1. شريط البحث والمسح -->
            <RowDefinition Height="Auto"/>
            <!-- 2. الجدول المرقّم -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. العنوان العلوي -->
        <TextBlock Grid.Row="0" 
                   Text="قائمة المستخدمين" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Foreground="{StaticResource TextPrimaryBrush}" 
                   Margin="0,0,0,12"/>

        <!-- 2. شريط البحث والمسح -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- زر المسح -->
                <ColumnDefinition Width="*"/>
                <!-- مربع البحث -->
            </Grid.ColumnDefinitions>

            <!-- زر المسح -->
            <Button Grid.Column="0" 
                    Command="{Binding ClearSearchCommand}"
                    Padding="12,5" 
                    Margin="0,0,10,0"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🧹" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="مسح" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <!-- مربع نص البحث -->
            <Grid Grid.Column="1">
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Padding="30,6,8,6" 
                         VerticalContentAlignment="Center" 
                         FontSize="13"
                         Background="{StaticResource SurfaceBrush}"
                         BorderBrush="{StaticResource BorderBrush}"/>

                <!-- أيقونة البحث -->
                <TextBlock Text="🔍" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center" 
                           Margin="8,0,0,0" 
                           Foreground="Gray" 
                           IsHitTestVisible="False"/>

                <!-- النص التوضيحي Placeholder -->
                <TextBlock Text="بحث باسم المستخدم، الكود، أو الاسم الكامل..." 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center" 
                           Margin="32,0,0,0" 
                           Foreground="Gray" 
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <controls:PaginatedGridControl 
             x:Name="DgUsers"
             Grid.Row="2"
             ItemsSource="{Binding UsersList}"
             SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
             CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
             TotalRows="{Binding TotalRows, Mode=TwoWay}"
             NumberOfRows="{Binding PageSize, Mode=TwoWay}"
             PageChangedCommand="{Binding PageChangedCommand}">

            <DataGridTextColumn Header="رقم المستخدم" Binding="{Binding USER_ID}" Width="1*"/>
            <DataGridTextColumn Header="كود المستخدم" Binding="{Binding USER_CODE}" Width="1*"/>
            <DataGridTextColumn Header="اسم الحساب" Binding="{Binding USER_NAME}" Width="1.5*"/>
            <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FULL_NAME}" Width="2*"/>
            <DataGridCheckBoxColumn Header="نشط" Binding="{Binding STATUS}" Width="0.8*"/>

        </controls:PaginatedGridControl>

    </Grid>
</Window>
