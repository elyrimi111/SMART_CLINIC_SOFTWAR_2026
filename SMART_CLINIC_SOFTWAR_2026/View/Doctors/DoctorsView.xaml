<UserControl x:Class="SMART_CLINIC_SOFTWAR_2026.View.Doctors.DoctorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Doctors"
             xmlns:vm="clr-namespace:SMART_CLINIC_SOFTWAR_2026.ViewModel.Doctors"
             xmlns:controls="clr-namespace:SMART_CLINIC_SOFTWAR_2026.View.Resorsus.DataViews"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             FlowDirection="RightToLeft">


    <Grid Background="{StaticResource BgMainBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- الهيدر الرئيسي -->
        <Border Grid.Row="0" 
                Background="{StaticResource HeaderBgBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="10,8">
            <TextBlock Text="إدارة بيانات الأطباء" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>

        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="410"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- القسم الأيمن: نموذج إدخال البيانات والأزرار -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" 
                          Header="بيانات الطبيب" 
                          FontWeight="Bold" 
                          Foreground="{StaticResource TextPrimaryBrush}" 
                          Background="{StaticResource SurfaceBrush}" 
                          BorderBrush="{StaticResource BorderBrush}" 
                          Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,4">

                            <!-- كود الطبيب -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="كود الطبيب" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>
                                <TextBox Grid.Column="1" Text="{Binding DOC_CODE, UpdateSourceTrigger=PropertyChanged}" IsEnabled="False"/>
                            </Grid>

                            <!-- اسم الطبيب -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="اسم الطبيب" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>
                                <TextBox Grid.Column="1" Text="{Binding DOC_NAME, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- التخصص -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="التخصص" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>
                                <TextBox Grid.Column="1" Text="{Binding DOC_MAJOR, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- الخبرة -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="الخبرة" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>
                                <TextBox Grid.Column="1" Text="{Binding DOC_EXP, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- تاريخ الميلاد -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="تاريخ الميلاد" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>
                                <DatePicker Grid.Column="1" SelectedDate="{Binding DOC_BD, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center"/>
                            </Grid>

                            <!-- رقم الهاتف -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="رقم الهاتف" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>
                                <TextBox Grid.Column="1" Text="{Binding DOC_MOBILE, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="العنوان" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>
                                <TextBox Grid.Column="1" Text="{Binding DOC_ADDRESS, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>


                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="المستخدم" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Normal" Margin="0,0,5,0"/>
                                <TextBox Grid.Column="1" 
                                         Text="{Binding USER_NAME, Mode=OneWay, FallbackValue='لم يتم تحديد مستخدم...'}" 
                                         IsReadOnly="True" 
                                         Background="#F5F5F5"
                                         Focusable="False"
                                         VerticalContentAlignment="Center"
                                         Padding="4,0"/>

                                <Button Grid.Column="2" 
                                        Command="{Binding OpenUsersListWindoCommand}"
                                        CommandParameter="{Binding USER_ID}"
                                        Content="🔍" 
                                        Width="35" 
                                        Margin="4,0,0,0"
                                        ToolTip="اضغط لاختيار مستخدم"/>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>

                <Border Grid.Row="1" 
                        Background="{StaticResource HeaderBgBrush}" 
                        BorderBrush="{StaticResource BorderBrush}" 
                        BorderThickness="1" 
                        Margin="0,8,0,0" 
                        Padding="4">
                    <UniformGrid Columns="4" Rows="1">
                        <Button x:Name="BtnSave" 
                                Command="{Binding AddDoctorCommand}" 
                                Style="{StaticResource AccentButtonStyle}" 
                                Margin="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="💾" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                                <TextBlock Text="حفظ" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnEdit" 
                                Command="{Binding UpdateDoctorCommand}" 
                                Margin="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✏️" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="تعديل" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnDelete" 
                                Command="{Binding DeleteDoctorCommand}" 
                                Style="{StaticResource DangerButtonStyle}" 
                                Margin="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✖" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                                <TextBlock Text="حذف" VerticalAlignment="Center" Foreground="{StaticResource TextWhiteBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnClear" 
                                Command="{Binding ClearFieldsCommand}" 
                                Margin="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🧹" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="مسح" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Border>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" 
                            Command="{Binding ClearSearchCommand}"
                            Padding="10,4" 
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧹" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="مسح" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <TextBox Grid.Column="1" 
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" 
                             VerticalContentAlignment="Center" 
                             FontSize="13"
                             Background="{StaticResource SurfaceBrush}"
                             BorderBrush="{StaticResource BorderBrush}"/>
                </Grid>

                <!-- الجدول المرقّم المخصص -->
                <controls:PaginatedGridControl 
                             Grid.Row="1"
                             ItemsSource="{Binding DoctorsList}"
                             SelectedItem="{Binding SelectedDoctor, Mode=TwoWay}"
                             CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
                             TotalRows="{Binding TotalRows, Mode=TwoWay}"
                             NumberOfRows="{Binding PageSize, Mode=TwoWay}"
                             PageChangedCommand="{Binding PageChangedCommand}">

                    <DataGridTextColumn Header="المعرف" Binding="{Binding DOC_ID}" Width="0.6*"/>
                    <DataGridTextColumn Header="كود الطبيب" Binding="{Binding DOC_CODE}" Width="0.8*"/>
                    <DataGridTextColumn Header="اسم الطبيب" Binding="{Binding DOC_NAME}" Width="2*"/>
                    <DataGridTextColumn Header="التخصص" Binding="{Binding DOC_MAJOR}" Width="1.5*"/>
                    <DataGridTextColumn Header="الخبرة" Binding="{Binding DOC_EXP}" Width="1*"/>
                    <DataGridTextColumn Header="تاريخ الميلاد" Binding="{Binding DOC_BD, StringFormat=\{0:dd/MM/yyyy\}}" Width="1.2*"/>
                    <DataGridTextColumn Header="الهاتف" Binding="{Binding DOC_MOBILE}" Width="1.3*"/>
                    <DataGridTextColumn Header="العنوان" Binding="{Binding DOC_ADDRESS}" Width="1.8*"/>

                </controls:PaginatedGridControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
